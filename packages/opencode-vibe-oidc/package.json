{
  "name": "opencode-vibe-oidc",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src scripts test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:host": "bun run test/host-smoke.ts",
    "test:consumer-host": "bun run test/host-integration.ts",
    "compatibility:current": "bun run test/check-compatibility.ts",
    "prepare:host": "bun run test/prepare-host.ts",
    "check:tool-runtimes": "bun --no-install run test/tool-compatibility/check-prepared.ts",
    "test:tool-baseline": "bun --no-install run test/tool-compatibility/baseline.ts",
    "contracts:opencode": "bun --no-install run test/tool-compatibility/update-contracts.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.88",
    "@opencode/plugin": "2.2.5",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.19",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode/cli": "2.2.5",
    "@types/bun": "1.3.11",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "bun@1.4.4"
}
